{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnterpriseFlutterConfiguration",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "organization": { "type": "string" },
        "description": { "type": "string" },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "enum": ["android", "ios", "web", "windows", "macos", "linux"] }
        },
        "device_targets": {
          "type": "array",
          "items": { "type": "string", "enum": ["phone", "tablet", "desktop"] }
        },
        "ui_category": { "type": "string" }
      },
      "required": ["name", "organization"]
    },
    "architecture": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["feature_first_clean", "modular_clean", "simplified_feature", "layered", "custom"] }
      },
      "required": ["style"]
    },
    "state_management": {
      "type": "object",
      "properties": {
        "solution": { "type": "string", "enum": ["bloc_cubit", "riverpod", "provider", "signals", "getx", "custom"] }
      },
      "required": ["solution"]
    },
    "dependency_injection": {
      "type": "object",
      "properties": {
        "solution": { "type": "string", "enum": ["get_it_injectable", "riverpod", "manual", "custom"] }
      },
      "required": ["solution"]
    },
    "networking": {
      "type": "object",
      "properties": {
        "solution": { "type": "string", "enum": ["retrofit_dio", "dio", "http", "custom"] }
      },
      "required": ["solution"]
    },
    "result_handling": {
      "type": "object",
      "properties": {
        "solution": { "type": "string", "enum": ["sealed_result", "dartz_either", "fpdart_either", "exceptions"] }
      },
      "required": ["solution"]
    },
    "routing": {
      "type": "object",
      "properties": {
        "solution": { "type": "string", "enum": ["navigator", "go_router", "auto_route", "custom"] }
      },
      "required": ["solution"]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "solution": { "type": "string", "enum": ["secure_storage_and_prefs", "drift", "isar", "hive", "custom"] }
      },
      "required": ["solution"]
    },
    "offline": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "strategy": { "type": "string", "enum": ["cache_first", "sync_queue", "none"] }
      }
    },
    "localization": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "locales": { "type": "array", "items": { "type": "string" } }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "solution": { "type": "string", "enum": ["app_observer", "structured_logging", "none"] }
      }
    }
  },
  "required": ["project", "architecture", "state_management", "dependency_injection", "networking", "routing"]
}
