{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Dev",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": ["--flavor", "dev", "--target", "lib/main_dev.dart"]
    },
    {
      "name": "Flutter: Staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": ["--flavor", "staging", "--target", "lib/main_staging.dart"]
    },
    {
      "name": "Flutter: Production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "--flavor",
        "production",
        "--target",
        "lib/main_production.dart",
        "--dart-define=BASE_URL=https://api.example.com",
        "--dart-define=API_KEY=your_production_api_key",
        "--dart-define=APP_NAME=YourApp"
      ]
    }
  ]
}
